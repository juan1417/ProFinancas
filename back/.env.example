# =============================================================
# ProFinancas backend — environment variables
# Copy to `.env` (gitignored) and fill in real values.
# =============================================================

# --- Django core ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Default: False. Set to True for local dev only.
DEBUG=False
# Comma-separated list of allowed hosts. Use '*' only in dev.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres in production) ---
# Option 1: Full connection URI (takes precedence over individual vars)
# Use this for Neon, Supabase, or any hosted Postgres with a pooler URL.
# URLDB=postgresql://user:password@host:5432/dbname?sslmode=require
# Option 2: Individual vars (used when URLDB is not set)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- CORS (optional) ---
# Comma-separated origins allowed to call the API.
# CORS_ALLOWED_ORIGINS=https://yourapp.com

# --- Test runner ---
# Set to True to force the in-memory SQLite backend. The pytest
# config in pytest.ini uses profinancas.settings_test instead and
# doesn't need this var.
DJANGO_TESTING=False

# --- Rate limiting (optional overrides) ---
# Default: 10 login attempts/min, 5 register attempts/hour per IP.
# Uncomment to tune.
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=5/hour
